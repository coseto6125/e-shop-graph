//! Regression: a structurally-valid rkyv graph.bin that violates a cross-field
//! invariant (bad MAGIC/VERSION, short/non-monotonic CSR offsets, out-of-range
//! edge endpoint, overrunning Str) must be REJECTED by LoadedGraph::open with an
//! Err — not pass load and panic later in the executor. Each case builds a
//! legal graph, corrupts one field, serializes, and asserts open() fails.

use esg_core::graph::{Edge, Graph, InEdge, Node, Str, MAGIC, VERSION};
use esg_core::store::{save, LoadedGraph};
use esg_core::{NodeKind, RelType};

/// A legal 2-node graph with one Product->Brand edge, built by hand so each
/// test can corrupt exactly one field. Mirrors what GraphBuilder::build emits.
fn legal_graph() -> Graph {
    // pool: "p\0b" — id/name share offsets; props is empty "{}" not needed for
    // these structural checks, so point props at a valid 0-len slice.
    let pool = b"pb".to_vec();
    let nodes = vec![
        Node {
            kind: NodeKind::Product,
            id: Str { off: 0, len: 1 },
            name: Str { off: 0, len: 1 },
            props: Str { off: 0, len: 0 },
        },
        Node {
            kind: NodeKind::Brand,
            id: Str { off: 1, len: 1 },
            name: Str { off: 1, len: 1 },
            props: Str { off: 0, len: 0 },
        },
    ];
    let edges = vec![Edge { rel: RelType::Brand, dst: 1 }];
    let in_edges = vec![InEdge { rel: RelType::Brand, src: 0 }];
    Graph {
        magic: MAGIC,
        version: VERSION,
        string_pool: pool,
        nodes,
        edges,
        // node 0 has the 1 out-edge, node 1 has none → [0,1,1]
        out_offsets: vec![0, 1, 1],
        in_edges,
        // node 1 is the target of the 1 in-edge → [0,0,1]
        in_offsets: vec![0, 0, 1],
    }
}

fn save_and_open(g: &Graph) -> anyhow::Result<LoadedGraph> {
    let dir = std::env::temp_dir();
    // unique-ish name without Date/rand: use the graph's shape as a discriminator.
    let path = dir.join(format!(
        "esg_load_validation_{}_{}_{}.bin",
        g.nodes.len(),
        g.edges.len(),
        g.out_offsets.len()
    ));
    save(g, &path)?;
    LoadedGraph::open(&path)
}

#[test]
fn legal_graph_loads() {
    let g = legal_graph();
    assert!(save_and_open(&g).is_ok(), "a legal graph must load");
}

#[test]
fn bad_magic_rejected() {
    let mut g = legal_graph();
    g.magic = *b"XXXX";
    assert!(save_and_open(&g).is_err());
}

#[test]
fn bad_version_rejected() {
    let mut g = legal_graph();
    g.version = VERSION + 99;
    assert!(save_and_open(&g).is_err());
}

#[test]
fn short_out_offsets_rejected() {
    let mut g = legal_graph();
    g.out_offsets = vec![0, 1]; // len 2, must be nodes+1 = 3
    assert!(save_and_open(&g).is_err());
}

#[test]
fn non_monotonic_offsets_rejected() {
    let mut g = legal_graph();
    g.out_offsets = vec![0, 1, 0]; // dips back down
    assert!(save_and_open(&g).is_err());
}

#[test]
fn offsets_last_not_edge_count_rejected() {
    let mut g = legal_graph();
    g.out_offsets = vec![0, 0, 0]; // last=0 but edges.len()=1
    assert!(save_and_open(&g).is_err());
}

#[test]
fn out_of_range_edge_dst_rejected() {
    let mut g = legal_graph();
    g.edges = vec![Edge { rel: RelType::Brand, dst: 99 }]; // only 2 nodes
    assert!(save_and_open(&g).is_err());
}

#[test]
fn overrunning_str_rejected() {
    let mut g = legal_graph();
    g.nodes[0].props = Str { off: 0, len: 9999 }; // pool is 2 bytes
    assert!(save_and_open(&g).is_err());
}
